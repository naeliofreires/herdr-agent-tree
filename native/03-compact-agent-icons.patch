+++ b/crates/herdr-gpui/src/sidebar/row/configured/tests/compact_icons.rs
@@ -0,0 +1,30 @@
+use super::super::visible_tokens;
+use crate::sidebar::tokens::{ResolvedToken, TextRole, TokenKind};
+use std::borrow::Cow;
+
+fn normal_tokens() -> Vec<ResolvedToken> {
+    vec![
+        ResolvedToken::unstyled(TokenKind::StateIcon),
+        ResolvedToken::unstyled(TokenKind::Text("tab 1".into(), TextRole::Secondary)),
+    ]
+}
+
+#[test]
+fn visible_tokens_borrows_normal_rows_unchanged() {
+    let normal = normal_tokens();
+    assert!(matches!(visible_tokens(&normal), Cow::Borrowed(_)));
+    assert_eq!(visible_tokens(&normal).as_ref(), normal.as_slice());
+}
+
+#[test]
+fn visible_tokens_filters_icon_before_budgeting() {
+    let normal = normal_tokens();
+    let with_icon = [
+        normal[0].clone(),
+        ResolvedToken::unstyled(TokenKind::AgentIcon),
+        normal[1].clone(),
+    ];
+    let visible = visible_tokens(&with_icon);
+    assert!(matches!(&visible, Cow::Owned(_)));
+    assert_eq!(visible.as_ref(), &[normal[0].clone(), normal[1].clone()]);
+}
