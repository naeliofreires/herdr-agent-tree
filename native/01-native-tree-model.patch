+use super::native_tokens;
+use crate::config::TokenStyle;
+use crate::sidebar::tokens::{ResolvedToken, TextRole, TokenKind};
+use gpui::SharedString;
+
+fn agent_row(with_prefix: bool) -> Vec<ResolvedToken> {
+    let mut row = vec![state_token(), agent_token(), tab_token()];
+    if with_prefix {
+        row.push(prefix_token());
+    }
+    row
+}
+
+fn state_token() -> ResolvedToken {
+    ResolvedToken::unstyled(TokenKind::StateIcon)
+}
+
+fn agent_token() -> ResolvedToken {
+    ResolvedToken {
+        kind: TokenKind::Text(SharedString::from("opencode"), TextRole::Agent),
+        style: TokenStyle {
+            bold: Some(true),
+            ..TokenStyle::default()
+        },
+    }
+}
+
+fn tab_token() -> ResolvedToken {
+    ResolvedToken::unstyled(TokenKind::Text("tab 1".into(), TextRole::Secondary))
+}
+
+fn prefix_token() -> ResolvedToken {
+    ResolvedToken::unstyled(TokenKind::Text("\u{200b}".into(), TextRole::Muted))
+}
+
+#[test]
+fn native_tokens_preserve_state_style_and_tab_with_prefix() {
+    let transformed = native_tokens(agent_row(true), Some("\u{200b}"));
+    assert_eq!(transformed.len(), 3);
+    assert_eq!(transformed[0], agent_row(false)[0]);
+    assert_eq!(transformed[1].kind, TokenKind::AgentIcon);
+    assert_eq!(transformed[1].style.bold, Some(true));
+    assert_eq!(transformed[2], agent_row(false)[2]);
+}
+
+#[test]
+fn native_tokens_keep_prefix_text_when_no_prefix_is_reported() {
+    let row = agent_row(true);
+    let transformed = native_tokens(row.clone(), None);
+    let mut expected = row;
+    expected[1].kind = TokenKind::AgentIcon;
+    assert_eq!(transformed, expected);
+}
