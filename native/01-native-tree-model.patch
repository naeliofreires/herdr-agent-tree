@@ -0,0 +1,61 @@
+pub const PATH_TOKEN: &str = "naeliofreires_tree_path";
+const PATH_PREFIX: &str = "v1:";
+const TREE_INDENT: f32 = 20.;
+pub(crate) const GUIDE_OFFSET: f32 = 12.;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct TreePath {
+    bits: [bool; 16],
+    length: u8,
+}
+
+impl TreePath {
+    /// Return the number of ancestor levels; e.g. `TreePath::depth()` for `v1:010` is `2`.
+    pub fn depth(self) -> usize {
+        usize::from(self.length.saturating_sub(1))
+    }
+
+    /// Return whether a guide continues at `level`; e.g. `v1:10` continues at level `0`.
+    pub fn continues_at(self, level: usize) -> bool {
+        level < usize::from(self.length) && self.bits[level]
+    }
+}
+
+/// Parse a bounded native tree path; e.g. `parse_path(Some("v1:01"))`.
+pub fn parse_path(value: Option<&str>) -> Option<TreePath> {
+    let digits = value?.strip_prefix(PATH_PREFIX)?;
+    let bounded = (1..=16).contains(&digits.len());
+    let binary = digits.bytes().all(|byte| byte == b'0' || byte == b'1');
+    if !bounded || !binary {
+        return None;
+    }
+    let mut bits = [false; 16];
+    for (index, byte) in digits.bytes().enumerate() {
+        bits[index] = byte == b'1';
+    }
+    Some(TreePath {
+        bits,
+        length: digits.len() as u8,
+    })
+}
+
+/// Return the x-offset for a guide level; e.g. `guide_origin(2)`.
+pub fn guide_origin(depth: usize) -> f32 {
+    GUIDE_OFFSET + depth as f32 * TREE_INDENT
+}
+
+/// Return row indentation for a path depth; e.g. `row_indent(2)`.
+pub fn row_indent(depth: usize) -> f32 {
+    depth as f32 * TREE_INDENT
+}
+
+/// Expand a path into paint levels; e.g. `guide_levels(parse_path(Some("v1:0")).unwrap())`.
+pub fn guide_levels(path: TreePath) -> Vec<(usize, bool)> {
+    (0..=path.depth())
+        .map(|level| (level, path.continues_at(level)))
+        .collect()
+}
+
+#[cfg(test)]
+#[path = "path/tests.rs"]
+mod tests;
