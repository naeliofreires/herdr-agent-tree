@@ -0,0 +1,29 @@
+use super::{guide_levels, guide_origin, parse_path, row_indent};
+
+#[test]
+fn parses_valid_paths_and_rejects_invalid_values() {
+    assert_eq!(parse_path(Some("v1:0")).map(|path| path.depth()), Some(0));
+    assert_eq!(parse_path(Some("v1:01")).map(|path| path.depth()), Some(1));
+    assert!(parse_path(None).is_none());
+    assert!(parse_path(Some("v1:")).is_none());
+    assert!(parse_path(Some("v1:012")).is_none());
+    assert!(parse_path(Some("v2:01")).is_none());
+    assert!(parse_path(Some("v1:00000000000000000")).is_none());
+}
+
+#[test]
+fn preserves_sibling_continuation_bits() {
+    let path = parse_path(Some("v1:1010")).expect("valid test path");
+    assert_eq!(
+        guide_levels(path),
+        [(0, true), (1, false), (2, true), (3, false)]
+    );
+}
+
+#[test]
+fn computes_native_geometry_offsets() {
+    assert_eq!(guide_origin(0), 12.);
+    assert_eq!(guide_origin(1), 32.);
+    assert_eq!(guide_origin(3), 72.);
+    assert_eq!(row_indent(3), 60.);
+}
