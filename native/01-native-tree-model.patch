@@ -0,0 +1,256 @@
+//! Native tree affordances for the opt-in Agent Tree plugin view.
+
+use super::tokens::{ResolvedToken, TokenKind};
+use crate::config::{AgentsPlacement, FontConfig, Theme};
+use gpui::{prelude::*, *};
+use herdr_client::protocol::{ClientShellAgent, ClientShellSnapshot};
+
+const PREFIX_TOKEN: &str = "naeliofreires_tree_prefix";
+mod path;
+use path::GUIDE_OFFSET;
+pub(crate) use path::{TreePath, guide_levels, guide_origin, parse_path, row_indent};
+#[cfg(test)]
+mod tests;
+
+pub(super) fn agent_path(agent: &ClientShellAgent) -> Option<TreePath> {
+    let value = agent
+        .tokens
+        .iter()
+        .find(|(name, _)| name == path::PATH_TOKEN)
+        .map(|(_, value)| value.as_str());
+    parse_path(value)
+}
+
+pub(super) fn workspace_has_tree(snapshot: &ClientShellSnapshot, workspace_id: &str) -> bool {
+    snapshot
+        .agents
+        .iter()
+        .any(|agent| agent.workspace_id == workspace_id && agent_path(agent).is_some())
+}
+
+pub(super) fn enabled(placement: AgentsPlacement, snapshot: &ClientShellSnapshot) -> bool {
+    placement == AgentsPlacement::Nested
+        && snapshot.agent_view_label.as_deref() == Some("Agent Tree")
+}
+
+pub(super) fn workspace_enabled(
+    nested: bool,
+    snapshot: &ClientShellSnapshot,
+    workspace_id: &str,
+) -> bool {
+    nested
+        && enabled(AgentsPlacement::Nested, snapshot)
+        && workspace_has_tree(snapshot, workspace_id)
+}
+
+pub(super) fn hide_prefix(
+    lines: Vec<Vec<ResolvedToken>>,
+    agent: &ClientShellAgent,
+) -> Vec<Vec<ResolvedToken>> {
+    let prefix = prefix_value(agent);
+    lines
+        .into_iter()
+        .map(|row| native_tokens(row, prefix))
+        .filter(|row: &Vec<_>| !row.is_empty())
+        .collect()
+}
+
+fn prefix_value(agent: &ClientShellAgent) -> Option<&str> {
+    agent
+        .tokens
+        .iter()
+        .find(|(name, _)| name == PREFIX_TOKEN)
+        .map(|(_, value)| value.as_str())
+}
+
+fn native_tokens(row: Vec<ResolvedToken>, prefix: Option<&str>) -> Vec<ResolvedToken> {
+    row.into_iter()
+        .filter_map(|mut token| {
+            if matches!(
+                &token.kind,
+                TokenKind::Text(_, super::tokens::TextRole::Agent)
+            ) {
+                token.kind = TokenKind::AgentIcon;
+                return Some(token);
+            }
+            let remove = prefix.is_some_and(
+                |prefix| matches!(&token.kind, TokenKind::Text(text, _) if text.as_ref() == prefix),
+            );
+            (!remove).then_some(token)
+        })
+        .collect()
+}
+
+/// Paint the branch path over a row; e.g. `guides(path, theme.muted)`.
+pub(super) fn guides(path: TreePath, color: u32) -> Div {
+    let painter = canvas(
+        |_, _, _| (),
+        move |bounds, _, window, _| paint_guides(path, color, bounds, window),
+    )
+    .size_full();
+    div()
+        .debug_selector(|| "native-tree-guides".into())
+        .absolute()
+        .inset_0()
+        .child(painter)
+}
+
+/// Prepare workspace typography; e.g. `workspace_font(true, &config.sidebar)`.
+pub(super) fn workspace_font(enhanced: bool, sidebar_font: &FontConfig) -> FontConfig {
+    let mut font = sidebar_font.clone();
+    if enhanced {
+        font.size = 14.;
+    }
+    font
+}
+
+/// Resolve workspace enhancement and font together; e.g. `workspace_context(...)`.
+pub(super) fn workspace_context(
+    nested: bool,
+    snapshot: &ClientShellSnapshot,
+    workspace_id: &str,
+    sidebar_font: &FontConfig,
+) -> (bool, FontConfig) {
+    let enhanced = workspace_enabled(nested, snapshot, workspace_id);
+    (enhanced, workspace_font(enhanced, sidebar_font))
+}
+
+/// Apply the native workspace header treatment when enabled.
+pub(super) fn style_workspace(row: Stateful<Div>, enhanced: bool, theme: &Theme) -> Stateful<Div> {
+    if enhanced {
+        workspace_header(row, theme)
+    } else {
+        row
+    }
+}
+
+pub(super) fn workspace_header(row: Stateful<Div>, theme: &Theme) -> Stateful<Div> {
+    let header_fill = crate::config::mix(theme.sidebar_background(), 0x000000, 18);
+    row.debug_selector(|| "native-tree-workspace-header".into())
+        .text_size(px(14.))
+        .font_weight(FontWeight::BOLD)
+        .border_b_1()
+        .border_color(rgba((theme.foreground << 8) | 0x30))
+        .bg(rgb(header_fill))
+}
+
+pub(super) fn workspace_card(unit: Div, theme: &Theme) -> Div {
+    let mut card = unit
+        .debug_selector(|| "native-tree-workspace-card".into())
+        .rounded(px(8.))
+        .border_1()
+        .border_color(rgba((theme.foreground << 8) | 0x20))
+        .bg(rgba((theme.surface << 8) | 0x18));
+    card.style().size.width = Some(Length::Auto);
+    card.mx(px(10.)).mb(px(12.))
+}
+
+pub(super) fn selected_agent(row: Stateful<Div>, theme: &Theme) -> Stateful<Div> {
+    let indicator = div()
+        .debug_selector(|| "native-tree-selected-indicator".into())
+        .absolute()
+        .left_0()
+        .top_0()
+        .bottom_0()
+        .w(px(2.))
+        .bg(rgb(theme.primary()));
+    row.debug_selector(|| "native-tree-selected-agent".into())
+        .relative()
+        .child(indicator)
+}
+
+#[derive(Clone, Copy)]
+struct GuideGeometry {
+    level: usize,
+    continues: bool,
+    depth: usize,
+    middle: Pixels,
+    weight: Pixels,
+    color: u32,
+}
+
+impl GuideGeometry {
+    fn base(path: TreePath, color: u32, bounds: Bounds<Pixels>, window: &Window) -> Self {
+        let scale = window.scale_factor();
+        Self {
+            level: 0,
+            continues: false,
+            depth: path.depth(),
+            middle: bounds.center().y,
+            weight: px((scale.round().max(1.)) / scale),
+            color,
+        }
+    }
+
+    fn at_level(self, level: usize, continues: bool) -> Self {
+        Self {
+            level,
+            continues,
+            ..self
+        }
+    }
+}
+
+fn paint_guides(path: TreePath, color: u32, bounds: Bounds<Pixels>, window: &mut Window) {
+    let geometry = GuideGeometry::base(path, color, bounds, window);
+    for (level, continues) in guide_levels(path) {
+        paint_level(window, bounds, geometry.at_level(level, continues));
+    }
+}
+
+fn paint_level(window: &mut Window, bounds: Bounds<Pixels>, geometry: GuideGeometry) {
+    if geometry.level < geometry.depth && !geometry.continues {
+        return;
+    }
+    let end = if geometry.level == geometry.depth && !geometry.continues {
+        geometry.middle
+    } else {
+        bounds.bottom()
+    };
+    let x = paint_vertical_segment(window, bounds, end, geometry);
+    if geometry.level == geometry.depth {
+        paint_horizontal(window, x, geometry.middle, geometry.weight, geometry.color);
+    }
+}
+
+fn paint_vertical_segment(
+    window: &mut Window,
+    bounds: Bounds<Pixels>,
+    end: Pixels,
+    geometry: GuideGeometry,
+) -> Pixels {
+    let x = bounds.origin.x + px(guide_origin(geometry.level));
+    paint_vertical(
+        window,
+        x,
+        bounds.origin.y,
+        end,
+        geometry.weight,
+        geometry.color,
+    );
+    x
+}
+
+fn paint_vertical(
+    window: &mut Window,
+    x: Pixels,
+    top: Pixels,
+    bottom: Pixels,
+    weight: Pixels,
+    color: u32,
+) {
+    window.paint_quad(fill(
+        Bounds::from_corners(point(x, top), point(x + weight, bottom)),
+        rgb(color),
+    ));
+}
+
+fn paint_horizontal(window: &mut Window, x: Pixels, middle: Pixels, weight: Pixels, color: u32) {
+    window.paint_quad(fill(
+        Bounds::from_corners(
+            point(x, middle),
+            point(x + px(GUIDE_OFFSET), middle + weight),
+        ),
+        rgb(color),
+    ));
+}
