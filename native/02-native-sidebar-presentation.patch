+++ b/crates/herdr-gpui/src/sidebar/layout_tests/native_tree.rs
@@ -0,0 +1,79 @@
+use super::*;
+use crate::sidebar::native_tree::workspace_has_tree;
+use crate::{config::AgentsPlacement, state::ConnectionStatus};
+use std::sync::Arc;
+
+#[test]
+fn malformed_or_absent_paths_do_not_enable_workspace() {
+    let mut snapshot = snapshot(1);
+    snapshot.agent_view_label = Some("Agent Tree".into());
+    snapshot.agents[0].tokens = vec![("naeliofreires_tree_path".into(), "v1:012".into())];
+    assert!(!workspace_has_tree(&snapshot, "w0"));
+    snapshot.agents[0].tokens.clear();
+    assert!(!workspace_has_tree(&snapshot, "w0"));
+}
+
+#[gpui::test]
+fn native_tree_marks_card_header_and_nested_selection(cx: &mut gpui::TestAppContext) {
+    let (fixture, cx) = cx.add_window_view(|window, cx| {
+        let view = cx.new(|cx| tree_fixture(window, cx));
+        cx.observe(&view, |_, _, cx| cx.notify()).detach();
+        SidebarFixture(view)
+    });
+    let view = cx.update(|_, cx| fixture.read(cx).0.clone());
+    cx.simulate_resize(size(px(800.), px(800.)));
+    cx.update(|window, cx| full_draw(window, cx).clear(cx));
+    assert!(cx.debug_bounds("native-tree-workspace-card").is_some());
+    assert!(cx.debug_bounds("native-tree-workspace-header").is_some());
+    assert!(cx.debug_bounds("native-tree-selected-agent").is_some());
+    let first = cx
+        .debug_bounds("column-agent-p0")
+        .expect("first agent column");
+    let second = cx
+        .debug_bounds("column-agent-p1")
+        .expect("nested agent column");
+    let third = cx
+        .debug_bounds("column-agent-p2")
+        .expect("grandchild column");
+    assert!(second.left() > first.left(), "{first:?} before {second:?}");
+    assert!(third.left() > second.left(), "{second:?} before {third:?}");
+    let first_left = first.left();
+    cx.update(|window, cx| {
+        view.update(cx, |view, cx| {
+            let snapshot = Arc::make_mut(view.live.snapshot.as_mut().expect("tree snapshot"));
+            snapshot.agents[0].focused = true;
+            snapshot.agents[2].focused = false;
+            cx.notify();
+        });
+        full_draw(window, cx).clear(cx);
+    });
+    let selected_first = cx
+        .debug_bounds("column-agent-p0")
+        .expect("selected first column");
+    assert_eq!(selected_first.left(), first_left);
+}
+
+fn tree_fixture(window: &mut Window, cx: &mut Context<HerdrWindow>) -> HerdrWindow {
+    let mut view = fixture_window(window, cx);
+    view.config.agents_placement = AgentsPlacement::Nested;
+    let mut listing = Arc::new(snapshot(3));
+    let snapshot = Arc::make_mut(&mut listing);
+    snapshot.agent_view_label = Some("Agent Tree".into());
+    snapshot.agent_order = vec!["p0".into(), "p1".into(), "p2".into()];
+    let mut grandchild = snapshot.agents[1].clone();
+    grandchild.pane_id = "p2".into();
+    grandchild.name = Some("Nested grandchild".into());
+    snapshot.agents.push(grandchild);
+    for (index, agent) in snapshot.agents.iter_mut().enumerate() {
+        agent.workspace_id = "w0".into();
+        agent.tab_id = "t0".into();
+        agent.tokens = vec![(
+            "naeliofreires_tree_path".into(),
+            ["v1:0", "v1:00", "v1:000"][index].into(),
+        )];
+        agent.focused = index == 2;
+    }
+    view.live.snapshot = Some(listing);
+    view.live.status = ConnectionStatus::Connected;
+    view
+}
